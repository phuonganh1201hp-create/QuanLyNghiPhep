    @if (studentEditorOpen && Session.Role == UserRole.PhongQLHV)
    {
        <div class="overlay" @onclick="() => studentEditorOpen = false">
            <div class="modal edit-modal" role="dialog" aria-modal="true" aria-label="Thông tin học viên" @onclick:stopPropagation="true">
                <div class="modal-head"><h2>@(string.IsNullOrEmpty(editingStudentCode) ? "Thêm học viên" : "Sửa thông tin học viên")</h2><button class="x-button" @onclick="() => studentEditorOpen = false">×</button></div>
                <div class="edit-fields form-grid">
                    <div class="field"><label>Mã học viên *</label><input @bind="studentForm.MaHocVien" maxlength="30" /></div>
                    <div class="field"><label>Họ và tên *</label><input @bind="studentForm.HoTen" maxlength="100" /></div>
                    <div class="field"><label>Lớp *</label><input @bind="studentForm.Lop" maxlength="60" /></div>
                    <div class="field"><label>Trung đội *</label><input @bind="studentForm.TrungDoi" maxlength="80" /></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(studentModalError)) { <div class="alert error modal-inline-error">@studentModalError</div> }
                <div class="modal-actions"><button class="btn outline" @onclick="() => studentEditorOpen = false">Hủy</button><button class="btn primary" @onclick="SaveStudent">Lưu học viên</button></div>
            </div>
        </div>
    }
    @if (studentDeleteTarget is not null && Session.Role == UserRole.PhongQLHV)
    {
        <div class="overlay" @onclick="() => studentDeleteTarget = null">
            <div class="modal confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <div class="warning-icon">!</div><h2>Xóa học viên?</h2><p>Xóa học viên <b>@studentDeleteTarget.HoTen</b> khỏi danh sách? Hệ thống không cho xóa học viên đã có đơn nghỉ.</p>
                <div class="modal-actions center"><button class="btn outline" @onclick="() => studentDeleteTarget = null">Hủy</button><button class="btn danger" @onclick="ConfirmDeleteStudent">Xác nhận xóa</button></div>
            </div>
        </div>
    }

    @if (deleteTarget is not null && Session.CanManage)
    {
        <div class="overlay" @onclick="() => deleteTarget = null"><div class="modal confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><div class="warning-icon">!</div><h2>Xóa đơn nghỉ phép?</h2><p>Đơn nghỉ phép của <b>@deleteTarget.HoTen</b> sẽ bị xóa khỏi danh sách. Thao tác này không thể hoàn tác.</p><div class="modal-actions center"><button class="btn outline" @onclick="() => deleteTarget = null">Hủy</button><button class="btn danger" @onclick="ConfirmDelete">Xác nhận xóa</button></div></div></div>
    }
}

@code {
    private string loginUser = "trungdoi";
    private string loginPassword = "";
    private UserRole loginRole = UserRole.TrungDoi;
    private string loginError = "";
    private string activeTab = "leaves";
    private string notice = "";
    private string pageError = "";
    private string keyword = "";
    private string filterClass = "";
    private string filterStatus = "";
    private string filterType = "";
    private string studentSearch = "";
    private List<Student> students = new();
    private List<LeaveRequest> allRecords = new();
    private List<AuditEntry> audit = new();
    private LeaveInput newInput = new();
    private LeaveInput editInput = new();
    private LeaveRequest? detail;
    private LeaveRequest? deleteTarget;
    private bool editOpen;
    private int editId;
    private string reviewNote = "";
    private string modalError = "";
    private bool studentEditorOpen;
    private Student studentForm = new();
    private string editingStudentCode = "";
    private string studentModalError = "";
    private Student? studentDeleteTarget;

    // Tách ngày và giờ giúp trình duyệt chọn giờ ổn định.
    private static DateTime SetHour(DateTime current, string time)
    {
        if (TimeSpan.TryParseExact(time, @"hh\:mm", System.Globalization.CultureInfo.InvariantCulture, out var span))
            return current.Date.Add(span);
        return current;
    }
    private DateTime NewStartDate { get => newInput.TuThoiDiem.Date; set => newInput.TuThoiDiem = value.Date.Add(newInput.TuThoiDiem.TimeOfDay); }
    private DateTime NewEndDate { get => newInput.DenThoiDiem.Date; set => newInput.DenThoiDiem = value.Date.Add(newInput.DenThoiDiem.TimeOfDay); }
    private string NewStartTime { get => newInput.TuThoiDiem.ToString("HH:mm"); set => newInput.TuThoiDiem = SetHour(newInput.TuThoiDiem, value); }
    private string NewEndTime { get => newInput.DenThoiDiem.ToString("HH:mm"); set => newInput.DenThoiDiem = SetHour(newInput.DenThoiDiem, value); }
    private DateTime EditStartDate { get => editInput.TuThoiDiem.Date; set => editInput.TuThoiDiem = value.Date.Add(editInput.TuThoiDiem.TimeOfDay); }
    private DateTime EditEndDate { get => editInput.DenThoiDiem.Date; set => editInput.DenThoiDiem = value.Date.Add(editInput.DenThoiDiem.TimeOfDay); }
    private string EditStartTime { get => editInput.TuThoiDiem.ToString("HH:mm"); set => editInput.TuThoiDiem = SetHour(editInput.TuThoiDiem, value); }
    private string EditEndTime { get => editInput.DenThoiDiem.ToString("HH:mm"); set => editInput.DenThoiDiem = SetHour(editInput.DenThoiDiem, value); }

    private bool CanReviewDetail(LeaveRequest request) => Session.IsAuthenticated &&
        ((Session.Role == UserRole.TrungDoi && request.TrangThai == LeaveStatuses.WaitingTrungDoi)
        || (Session.Role == UserRole.PhongQLHV && request.TrangThai == LeaveStatuses.WaitingPhong));


    //Tạo nút ẩn/hiện menu
    private bool menuCollapsed = false;

    private void ToggleSidebar()
    {
          menuCollapsed = !menuCollapsed;
    }

    //Tạo nút thông tin tk và bảo mật
    private bool showAccountWindow = false;
    private bool showSecurityWindow = false;

    private string PageTitle => activeTab switch
    {
        "dashboard" => "Tổng quan nghỉ phép",
        "students" => "Danh sách học viên",
        "reports" => "Báo cáo và thống kê",
        "audit" => "Nhật ký xử lý",
        _ => "Quản lý học viên nghỉ phép"
    };
    private string PageSubtitle => activeTab switch
    {
        "dashboard" => "Theo dõi tình hình nghỉ phép và tiến độ xử lý đơn của học viên.",
        "students" => "Tra cứu thông tin học viên và trung đội trực thuộc.",
        "reports" => "Tổng hợp số liệu và xuất báo cáo phục vụ công tác quản lý.",
        "audit" => "Theo dõi các thao tác cập nhật và xét duyệt đơn nghỉ phép.",
        _ => "Tiếp nhận, tra cứu và xử lý đơn xin nghỉ phép theo quy trình quản lý."
    };
    private List<string> Classes => students.Select(x => x.Lop).Distinct().OrderBy(x => x).ToList();
    private int PendingCount => allRecords.Count(x => x.TrangThai is LeaveStatuses.WaitingTrungDoi or LeaveStatuses.WaitingPhong);
    private int ApprovedCount => allRecords.Count(x => x.TrangThai == "Đã duyệt");
    private int RejectedCount => allRecords.Count(x => x.TrangThai == "Từ chối");
    private int Percentage(int count) => allRecords.Count == 0 ? 0 : (int)Math.Round(100.0 * count / allRecords.Count);
    private List<LeaveRequest> Filtered => allRecords.Where(x =>
                string.IsNullOrWhiteSpace(keyword)
                || x.MaHocVien.Contains(keyword.Trim(), StringComparison.OrdinalIgnoreCase)
                || x.HoTen.Contains(keyword.Trim(), StringComparison.OrdinalIgnoreCase)
                || x.LyDo.Contains(keyword.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrEmpty(filterClass) || x.Lop == filterClass)
            .Where(x => string.IsNullOrEmpty(filterStatus) || x.TrangThai == filterStatus)
            .Where(x => string.IsNullOrEmpty(filterType) || x.LoaiDon == filterType)
            .ToList();
    private List<Student> FilteredStudents => students.Where(x =>
            string.IsNullOrWhiteSpace(studentSearch)
            || x.MaHocVien.Contains(studentSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || x.HoTen.Contains(studentSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || x.Lop.Contains(studentSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private void OpenAddStudent()
    {
        if (Session.Role != UserRole.PhongQLHV) return;
        studentForm = new Student();
        editingStudentCode = "";
        studentModalError = "";
        studentEditorOpen = true;
    }
    private void OpenEditStudent(Student student)
    {
        if (Session.Role != UserRole.PhongQLHV) return;
        editingStudentCode = student.MaHocVien;
        studentForm = new Student { MaHocVien = student.MaHocVien, HoTen = student.HoTen,
            Lop = student.Lop, TrungDoi = student.TrungDoi };
        studentModalError = "";
        studentEditorOpen = true;
    }
    private void SaveStudent()
    {
        try
        {
            if (string.IsNullOrEmpty(editingStudentCode)) Repository.AddStudent(Session, studentForm);
            else Repository.UpdateStudent(Session, editingStudentCode, studentForm);
            studentEditorOpen = false;
            Reload();
            notice = "Đã lưu thông tin học viên.";
        }
        catch (Exception ex) { studentModalError = ex.Message; }
    }
    private void AskDeleteStudent(Student student)
    {
        if (Session.Role == UserRole.PhongQLHV) studentDeleteTarget = student;
    }
    private void ConfirmDeleteStudent()
    {
        if (studentDeleteTarget is null) return;
        try
        {
            Repository.DeleteStudent(Session, studentDeleteTarget.MaHocVien);
            studentDeleteTarget = null;
            Reload();
            notice = "Đã xóa học viên.";
        }
        catch (Exception ex) { studentDeleteTarget = null; pageError = ex.Message; }
    }

    private void ClearNotice() => notice = string.Empty;
    private void ClearPageError() => pageError = string.Empty;

    private void Login()
    {
        loginError = "";
        if (!Auth.TryLogin(loginUser, loginPassword, loginRole, out loginError)) return;
        loginPassword = "";
        activeTab = "leaves";
        Reload();
    }

    private void Logout()
    {
        Session.SignOut();
        detail = null;
        editOpen = false;
        deleteTarget = null;
        loginPassword = "";
        loginError = "";
        notice = "";
        pageError = "";
    }

    private void Reload()
    {
        try
        {
            students = Repository.GetStudents(Session);
            allRecords = Repository.GetRequests(Session);
            audit = Session.CanExport ? Repository.GetAudit(Session) : new();
            pageError = "";
        }
        catch (Exception ex) { pageError = ex.Message; }
    }

    private void SwitchTab(string tab)
    {
        if ((tab == "reports" || tab == "audit") && !Session.CanExport) return;
        activeTab = tab;
        notice = "";
        pageError = "";
    }

    private void ShowDashboard() => SwitchTab("dashboard");
    private void ShowLeaves() { SwitchTab("leaves"); Reload(); }
    private void ShowStudents() { SwitchTab("students"); Reload(); }
    private void ShowReports() => SwitchTab("reports");
    private void ShowAudit() => SwitchTab("audit");
    private void ResetStudentSearch() => studentSearch = string.Empty;

    private void ResetFilters()
    {
        keyword = "";
        filterClass = "";
        filterStatus = "";
        filterType = "";
    }

    private void ClearNew()
    {
        newInput = new LeaveInput();
        pageError = "";
    }

    private string SelectedStudentLabel(string code)
    {
        var student = students.FirstOrDefault(x => x.MaHocVien == code);
        return student is null ? "Chưa chọn học viên" : $"{student.HoTen} · {student.Lop}";
    }

    private void AddLeave()
    {
        try
        {
            Repository.Add(Session, newInput);
            Reload();
            ClearNew();
            notice = "Đã tạo đơn. Đơn đang chờ giáo viên trung đội duyệt trước khi chuyển tới Phòng QLHV.";
        }
        catch (Exception ex) { pageError = ex.Message; notice = ""; }
    }

    private void PreviewNew()
    {
        var student = newInput.MaHocVien == "__manual__"
            ? new Student { MaHocVien = newInput.MaHocVienTuNhap, HoTen = newInput.TenHocVienTuNhap, Lop = newInput.LopTuNhap }
            : students.FirstOrDefault(x => x.MaHocVien == newInput.MaHocVien);
        if (student is null || string.IsNullOrWhiteSpace(student.HoTen) || string.IsNullOrWhiteSpace(student.Lop))
        { pageError = "Vui lòng chọn hoặc nhập đầy đủ thông tin học viên trước khi xem mẫu đơn."; return; }
        detail = new LeaveRequest
        {
            MaHocVien = student.MaHocVien, HoTen = student.HoTen, Lop = student.Lop,
            TrungDoi = newInput.TrungDoi, TuThoiDiem = newInput.TuThoiDiem,
            DenThoiDiem = newInput.DenThoiDiem, LyDo = newInput.LyDo,
            DiaChiNoiNghi = newInput.DiaChiNoiNghi, TrangThai = "Bản xem trước"
        };
        pageError = "";
    }

    private void OpenDetail(LeaveRequest record)
    {
        detail = record.Clone();
        reviewNote = "";
        modalError = "";
        pageError = "";
    }

    private void CloseDetail() => detail = null;

    private void BeginEdit(LeaveRequest record)
    {
        if (!Session.CanManage || record.TrangThai != LeaveStatuses.WaitingTrungDoi) return;
        editId = record.Id;
        editInput = LeaveInput.From(record);
        detail = null;
        modalError = "";
        editOpen = true;
    }

    private void CancelEdit() => editOpen = false;

    private void SaveEdit()
    {
        try
        {
            Repository.Update(Session, editId, editInput);
            editOpen = false;
            Reload();
            notice = "Đã cập nhật đơn nghỉ phép.";
        }
        catch (Exception ex) { modalError = ex.Message; notice = ""; }
    }

    private void AskDelete(LeaveRequest item)
    {
        if (Session.CanManage && item.TrangThai == LeaveStatuses.WaitingTrungDoi) deleteTarget = item.Clone();
    }

    private void ConfirmDelete()
    {
        if (deleteTarget is null) return;
        try
        {
            Repository.Delete(Session, deleteTarget.Id);
            deleteTarget = null;
            Reload();
            notice = "Đã xóa đơn nghỉ phép.";
        }
        catch (Exception ex) { deleteTarget = null; pageError = ex.Message; }
    }

    private void ReviewLeave(bool approved)
    {
        if (detail is null) return;
        try
        {
            var updated = Repository.Review(Session, detail.Id, approved, reviewNote);
            detail = null;
            Reload();
            notice = approved
                ? updated.TrangThai == LeaveStatuses.WaitingPhong
                    ? "Giáo viên trung đội đã duyệt. Đơn được chuyển tới Phòng QLHV."
                    : "Phòng QLHV đã duyệt. Đơn hoàn chỉnh và đã chuyển tới giáo viên bộ môn."
                : "Đã từ chối đơn nghỉ phép.";
        }
        catch (Exception ex) { modalError = ex.Message; notice = ""; }
    }

    private async Task ExportExcel()
    {
        try
        {
            var rows = activeTab == "leaves" ? Filtered : allRecords;
            var bytes = Repository.ExportExcel(Session, rows);
            string name = $"DanhSachNghiPhep_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("leaveApp.downloadBase64", name, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            notice = $"Đã chuẩn bị file Excel với {rows.Count} đơn nghỉ phép.";
        }
        catch (Exception ex) { pageError = ex.Message; notice = ""; }
    }

    private async Task PrintDetail()
    {
        try { await JS.InvokeVoidAsync("leaveApp.printPaper", "leave-print-paper"); }
        catch (Exception ex) { pageError = ex.Message; }
    }

    private string StatusClass(string s) => s switch
    {
        "Đã duyệt" => "status approved",
        "Từ chối" => "status rejected",
        LeaveStatuses.WaitingTrungDoi or LeaveStatuses.WaitingPhong => "status pending",
        _ => "status neutral"
    };

    private RenderFragment RecentTable() => builder =>
    {
        // Dùng lại bảng có sẵn với 5 đơn gần nhất, giữ nút Xem chi tiết hoạt động.
        builder.OpenComponent<RecentLeaveTable>(0);
        builder.AddAttribute(1, "Items", allRecords.Take(5).ToList());
        builder.AddAttribute(2, "View", EventCallback.Factory.Create<LeaveRequest>(this, OpenDetail));
        builder.CloseComponent();
    };

    private RenderFragment LeaveTable(List<LeaveRequest> items) => builder =>
    {
        builder.OpenComponent<LeaveDataTable>(0);
        builder.AddAttribute(1, "Items", items);
        builder.AddAttribute(2, "CanManage", Session.CanManage);
        builder.AddAttribute(3, "CanApprove", Session.CanApprove);
        builder.AddAttribute(4, "View", EventCallback.Factory.Create<LeaveRequest>(this, OpenDetail));
        builder.AddAttribute(5, "Edit", EventCallback.Factory.Create<LeaveRequest>(this, BeginEdit));
        builder.AddAttribute(6, "Delete", EventCallback.Factory.Create<LeaveRequest>(this, AskDelete));
        builder.CloseComponent();
    };
}
