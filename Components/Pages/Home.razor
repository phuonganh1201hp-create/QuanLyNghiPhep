@page "/"
@inject DemoSession Session
@inject DemoAuthService Auth
@inject LeaveRepository Repository
@inject IJSRuntime JS

<PageTitle>Quản lý nghỉ phép | Học viện An ninh nhân dân</PageTitle>

@if (!Session.IsAuthenticated)
{
    <div class="login-screen">
        <div class="login-right">
            <form class="login-card" @onsubmit="Login" @onsubmit:preventDefault="true">
                <div class="login-card-icon">▣</div>
                <p class="eyebrow">CỔNG QUẢN LÝ</p>
                <h2>Đăng nhập hệ thống</h2>
                <p class="muted">Vui lòng nhập tài khoản và chọn đúng vai trò công tác.</p>
                <label class="field-label" for="username">Tên đăng nhập</label>
                <input id="username" class="field-input" autocomplete="username" placeholder="Nhập tài khoản" @bind="loginUser" @bind:event="oninput" />
                <label class="field-label" for="password">Mật khẩu</label>
                <input id="password" class="field-input" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" @bind="loginPassword" @bind:event="oninput" />
                <label class="field-label" for="role">Chức vụ / vai trò</label>
                <select id="role" class="field-input" @bind="loginRole">
                    <option value="@UserRole.TrungDoi">Giáo viên trung đội</option>
                    <option value="@UserRole.PhongQLHV">Cán bộ Phòng QLHV</option>
                    <option value="@UserRole.BoMon">Giáo viên bộ môn</option>
                </select>
                @if (!string.IsNullOrEmpty(loginError))
                {
                    <div class="alert error">@loginError</div>
                }
                <button class="btn primary login-submit" type="submit"><span>↪</span> Đăng nhập</button>
                <div class="demo-accounts">
                    <strong>Tài khoản dùng thử:</strong>
                    <p><code>trungdoi</code> · Giáo viên trung đội</p>
                    <p><code>phongqlhv</code> · Cán bộ Phòng QLHV</p>
                    <p><code>bomon</code> · Giáo viên bộ môn</p>
                    <span>Mật khẩu chung: <code>Demo@@2026</code></span>
                </div>
            </form>
        </div>
    </div>
}

else
{
    <div class="main-app">
        <header class="academy-banner">
           <div class="academy-brand">
              <img src="/image/logo_hoc_vien.png"
                 alt="Logo Học viện An ninh nhân dân" />

              <div class="academy-banner-text">
                 <h1>HỌC VIỆN AN NINH NHÂN DÂN</h1>

                 <div class="academy-subtitle">
                      <span>HỆ THỐNG QUẢN LÝ HỌC VIÊN NGHỈ PHÉP</span>

                      <span class="academy-demo">
                         PHÒNG QUẢN LÝ HỌC VIÊN · HỆ THỐNG DEMO
                      </span>
                 </div>
              </div>

           </div>

           <div class="academy-banner-actions">
              <button type="button"
                      @onclick="() => showAccountWindow = true">
                 Thông tin tài khoản
              </button>

              <button type="button"
                      @onclick="() => showSecurityWindow = true">
                 Bảo mật
              </button>
           </div>

        </header>


        <div class="shell @(menuCollapsed ? "menu-collapsed" : "")">
            <aside class="sidebar">
            <div class="sidebar-meta"><span class="live-dot"></span> Hệ thống đang hoạt động</div>
            <nav class="menu">
                <div class="menu-caption">MENU CHÍNH</div>
                <button class="nav-link @(activeTab == "dashboard" ? "active" : "")" @onclick="ShowDashboard"><span>⌂</span> Tổng quan</button>
                <button class="nav-link @(activeTab == "leaves" ? "active" : "")" @onclick="ShowLeaves"><span>▤</span> Quản lý đơn nghỉ <b class="nav-count">@allRecords.Count</b></button>
                <button class="nav-link @(activeTab == "students" ? "active" : "")" @onclick="ShowStudents"><span>♙</span> Danh sách học viên</button>
                @if (Session.CanExport)
                {
                    <div class="menu-caption subcaption">BÁO CÁO & GIÁM SÁT</div>
                    <button class="nav-link @(activeTab == "reports" ? "active" : "")" @onclick="ShowReports"><span>▥</span> Thống kê báo cáo</button>
                    <button class="nav-link @(activeTab == "audit" ? "active" : "")" @onclick="ShowAudit"><span>◷</span> Nhật ký xử lý</button>
                }
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-person">@(Session.UserName.Length > 0 ? Session.UserName.Substring(0, 1).ToUpperInvariant() : "?")</div>
                <div><strong>@Session.UserName</strong><small>@Session.RoleDisplay</small></div>
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">

               <div class="topbar-left">

                  <button type="button"
                          class="toolbar-button"
                          title="Ẩn / hiện menu"
                          @onclick="ToggleSidebar">
                     ☰
                  </button>

               </div>

               <div class="header-right">

                   <span class="date-chip">
                       ◷ @DateTime.Today.ToString("dd/MM/yyyy")
                   </span>

                   <span class="role-chip">
                         @Session.RoleDisplay
                   </span>

                   <button class="btn signout" @onclick="Logout">
                           Đăng xuất ↗
                   </button>

               </div>

            </header>

            <main class="content">
                
               <div class="page-heading heading-only-actions">
                 <div class="heading-actions">

                     @if (Session.CanExport)
                         {
                         <button class="btn outline"
                                 @onclick="ExportExcel">
                                 ⇩ Xuất Excel
                         </button>
                         }

                     @if (Session.CanManage && activeTab != "leaves")
                         {
                         <button class="btn primary"
                                 @onclick="ShowLeaves">
                                 ＋ Lập đơn nghỉ
                         </button>
                         }

                 </div>
               </div>


                @if (!string.IsNullOrWhiteSpace(notice))
                {
                    <div class="alert success" role="status">@notice <button @onclick="ClearNotice" aria-label="Đóng thông báo">×</button></div>
                }
                @if (!string.IsNullOrWhiteSpace(pageError))
                {
                    <div class="alert error" role="alert">@pageError <button @onclick="ClearPageError" aria-label="Đóng thông báo">×</button></div>
                }

                @if (activeTab == "dashboard")
                {
                    <div class="stats-grid">
                        <div class="stat-card"><div class="stat-icon navy">▤</div><div><span>TỔNG SỐ ĐƠN</span><strong>@allRecords.Count</strong><small>Tất cả đơn nghỉ phép</small></div></div>
                        <div class="stat-card"><div class="stat-icon amber">◷</div><div><span>CHỜ XÉT DUYỆT</span><strong>@PendingCount</strong><small>Cần được xử lý</small></div></div>
                        <div class="stat-card"><div class="stat-icon green">✓</div><div><span>ĐÃ DUYỆT</span><strong>@ApprovedCount</strong><small>Đơn được chấp thuận</small></div></div>
                        <div class="stat-card"><div class="stat-icon rose">×</div><div><span>ĐÃ TỪ CHỐI</span><strong>@RejectedCount</strong><small>Đơn không được duyệt</small></div></div>
                    </div>
                    <div class="dashboard-grid">
                        <section class="panel">
                            <div class="panel-head"><div><h2>Tình hình xử lý đơn</h2><p>Tỷ lệ theo từng trạng thái trên tổng số đơn</p></div><span class="panel-icon">▥</span></div>
                            <div class="chart-body">
                                <div class="bar-row"><span>Đã duyệt</span><div class="bar-track"><div class="bar-fill approved-fill" style="width:@Percentage(ApprovedCount)%"></div></div><strong>@ApprovedCount</strong></div>
                                <div class="bar-row"><span>Chờ duyệt</span><div class="bar-track"><div class="bar-fill pending-fill" style="width:@Percentage(PendingCount)%"></div></div><strong>@PendingCount</strong></div>
                                <div class="bar-row"><span>Từ chối</span><div class="bar-track"><div class="bar-fill rejected-fill" style="width:@Percentage(RejectedCount)%"></div></div><strong>@RejectedCount</strong></div>
                            </div>
                        </section>
                        <section class="panel">
                            <div class="panel-head"><div><h2>Thông tin hệ thống</h2><p>Chế độ chạy dành cho bài tập lớn</p></div><span class="panel-icon">ⓘ</span></div>
                            <div class="quick-info"><div><span>Học viên trong danh mục</span><strong>@students.Count</strong></div><div><span>Đơn nghỉ trong ngày</span><strong>@allRecords.Count(x => x.LoaiDon == "Trong ngày")</strong></div><div><span>Đơn nghỉ dài ngày</span><strong>@allRecords.Count(x => x.LoaiDon == "Dài ngày")</strong></div><div><span>Quyền truy cập</span><strong>@Session.RoleDisplay</strong></div></div>
                        </section>
                    </div>
                    <section class="panel"><div class="panel-head"><div><h2>Đơn nghỉ gần đây</h2><p>Nhấn xem để mở hồ sơ nghỉ phép</p></div><button class="link-button" @onclick="ShowLeaves">Xem tất cả →</button></div>@RecentTable()</section>
                }
                else if (activeTab == "leaves")
                {
                    @if (Session.CanManage)
                    {
                        <section class="panel form-panel">
                            <div class="panel-head"><div><h2>▤ LẬP ĐƠN XIN NGHỈ PHÉP</h2><p>Điền theo mẫu đơn nghỉ phép của Học viện. Các ô có dấu * là bắt buộc.</p></div><span class="form-status">ĐƠN MỚI</span></div>
                            <div class="form-body">
                                <div class="form-grid">
                                    <div class="field"><label>Học viên <em>*</em></label><select @bind="newInput.MaHocVien"><option value="">-- Chọn mã / tên học viên --</option>@foreach (var s in students) { <option value="@s.MaHocVien">@s.MaHocVien - @s.HoTen</option> }<option value="__manual__">＋ Tự nhập học viên</option></select></div>
                                    @if (newInput.MaHocVien == "__manual__")
                                    {
                                        <div class="field"><label>Mã học viên tự nhập <em>*</em></label><input @bind="newInput.MaHocVienTuNhap" maxlength="30" placeholder="Nhập mã học viên" /></div>
                                        <div class="field"><label>Họ tên học viên <em>*</em></label><input @bind="newInput.TenHocVienTuNhap" maxlength="100" placeholder="Nhập họ tên" /></div>
                                        <div class="field"><label>Lớp học viên <em>*</em></label><input @bind="newInput.LopTuNhap" maxlength="60" placeholder="Nhập lớp" /></div>
                                    }
                                    <div class="field"><label>Học viên lớp</label><input value="@(newInput.MaHocVien == "__manual__" ? "Tự nhập học viên" : SelectedStudentLabel(newInput.MaHocVien))" disabled /></div>
                                    <div class="field"><label>Chủ nhiệm trung đội <em>*</em></label><input @bind="newInput.TrungDoi" maxlength="80" placeholder="VD: Trung đội 1" /></div>
                                    <div class="field"><label>Thời gian bắt đầu <em>*</em></label><div class="date-time-pair"><input aria-label="Ngày bắt đầu" type="date" @bind="NewStartDate" @bind:format="yyyy-MM-dd" /><input aria-label="Giờ bắt đầu" type="time" step="60" value="@NewStartTime" @onchange="e => NewStartTime = e.Value?.ToString() ?? string.Empty" /></div></div>
                                    <div class="field"><label>Thời gian kết thúc <em>*</em></label><div class="date-time-pair"><input aria-label="Ngày kết thúc" type="date" @bind="NewEndDate" @bind:format="yyyy-MM-dd" /><input aria-label="Giờ kết thúc" type="time" step="60" value="@NewEndTime" @onchange="e => NewEndTime = e.Value?.ToString() ?? string.Empty" /></div></div>
                                    <div class="field"><label>Loại đơn (tự tính)</label><input value="@(newInput.TuThoiDiem.Date == newInput.DenThoiDiem.Date ? "Trong ngày" : "Dài ngày")" disabled /></div>
                                    <div class="field span-2"><label>Lý do xin nghỉ <em>*</em></label><textarea @bind="newInput.LyDo" maxlength="500" rows="2" placeholder="Nhập lý do xin nghỉ phép..."></textarea></div>
                                    <div class="field span-2"><label>Địa chỉ nơi nghỉ <em>*</em></label><input @bind="newInput.DiaChiNoiNghi" maxlength="300" placeholder="Nhập địa chỉ cụ thể nơi đến nghỉ" /></div>
                                </div>
                                <div class="form-footer"><span>Đơn mới sẽ có trạng thái <b>Chờ duyệt trung đội</b> sau khi gửi.</span><div><button class="btn outline" @onclick="ClearNew">↻ Làm lại</button><button class="btn outline" @onclick="PreviewNew">◉ Xem mẫu đơn</button><button class="btn primary" @onclick="AddLeave">➤ Gửi đơn nghỉ phép</button></div></div>
                            </div>
                        </section>
                    }
                    <section class="panel list-panel">
                        <div class="panel-head"><div><h2>▥ DANH SÁCH ĐƠN XIN NGHỈ PHÉP</h2><p>Tra cứu, theo dõi và xử lý đơn nghỉ học của học viên.</p></div><span class="total-label">@Filtered.Count bản ghi</span></div>
                        <div class="filters">
                            <div class="field wide"><label>Tìm kiếm</label><input @bind="keyword" @bind:event="oninput" placeholder="Mã HV, họ tên, lý do..." /></div>
                            <div class="field"><label>Lớp</label><select @bind="filterClass"><option value="">Tất cả lớp</option>@foreach (var c in Classes) { <option value="@c">@c</option> }</select></div>
                            <div class="field"><label>Loại đơn</label><select @bind="filterType"><option value="">Tất cả</option><option>Trong ngày</option><option>Dài ngày</option></select></div>
                            <div class="field"><label>Trạng thái</label><select @bind="filterStatus"><option value="">Tất cả</option><option value="@LeaveStatuses.WaitingTrungDoi">Chờ duyệt trung đội</option><option value="@LeaveStatuses.WaitingPhong">Chờ duyệt Phòng QLHV</option><option>Đã duyệt</option><option>Từ chối</option></select></div>
                            <div class="filter-buttons"><button class="btn small outline" @onclick="ResetFilters">↻ Reset</button></div>
                        </div>
                        @LeaveTable(Filtered)
                    </section>
                    <div class="bottom-export">Tổng số đơn trong hệ thống: <b>@allRecords.Count</b> @if (Session.CanExport) { <button class="btn secondary" @onclick="ExportExcel">⇩ Xuất danh sách lọc ra Excel (.xlsx)</button> }</div>
                }
                else if (activeTab == "students")
                {
                    <section class="panel">
                        <div class="panel-head"><div><h2>DANH SÁCH HỌC VIÊN</h2><p>Danh mục học viên mẫu dùng để điền đơn nghỉ phép.</p></div><div class="heading-actions"><span class="total-label">@students.Count học viên</span>@if (Session.Role == UserRole.PhongQLHV) { <button class="btn primary" @onclick="OpenAddStudent">＋ Thêm học viên</button> }</div></div>
                        <div class="filters"><div class="field wide"><label>Tra cứu học viên</label><input @bind="studentSearch" @bind:event="oninput" placeholder="Tìm tên, mã học viên hoặc lớp..." /></div><button class="btn small outline" @onclick="ResetStudentSearch">↻ Reset</button></div>
                        <div class="table-scroll"><table><thead><tr><th>STT</th><th>MÃ HỌC VIÊN</th><th>HỌ VÀ TÊN</th><th>LỚP</th><th>TRUNG ĐỘI</th><th>SỐ ĐƠN NGHỈ</th>@if (Session.Role == UserRole.PhongQLHV) { <th>THAO TÁC</th> }</tr></thead><tbody>@{int studentIndex = 0;}@foreach (var student in FilteredStudents) { studentIndex++; <tr><td>@studentIndex</td><td><b>@student.MaHocVien</b></td><td>@student.HoTen</td><td>@student.Lop</td><td>@student.TrungDoi</td><td>@allRecords.Count(x => x.MaHocVien == student.MaHocVien)</td>@if (Session.Role == UserRole.PhongQLHV) { <td><div class="table-actions"><button class="btn mini outline" @onclick="() => OpenEditStudent(student)">Sửa</button><button class="btn mini danger" @onclick="() => AskDeleteStudent(student)">Xóa</button></div></td> }</tr> }</tbody></table></div>
                    </section>
                }
                else if (activeTab == "reports" && Session.CanExport)
                {
                    <div class="stats-grid">
                        <div class="stat-card"><div class="stat-icon navy">▤</div><div><span>TỔNG ĐƠN</span><strong>@allRecords.Count</strong><small>Toàn bộ đơn nghỉ</small></div></div>
                        <div class="stat-card"><div class="stat-icon amber">◷</div><div><span>CHƯA XỬ LÝ</span><strong>@PendingCount</strong><small>Chờ xét duyệt</small></div></div>
                        <div class="stat-card"><div class="stat-icon green">✓</div><div><span>ĐÃ DUYỆT</span><strong>@ApprovedCount</strong><small>Được đồng ý</small></div></div>
                        <div class="stat-card"><div class="stat-icon rose">×</div><div><span>TỪ CHỐI</span><strong>@RejectedCount</strong><small>Không chấp thuận</small></div></div>
                    </div>
                    <section class="panel"><div class="panel-head"><div><h2>THỐNG KÊ THEO LỚP</h2><p>Số đơn nghỉ học tương ứng với từng lớp</p></div><button class="btn outline" @onclick="ExportExcel">⇩ Xuất Excel</button></div><div class="table-scroll"><table><thead><tr><th>STT</th><th>LỚP</th><th>TỔNG ĐƠN</th><th>CHỜ DUYỆT</th><th>ĐÃ DUYỆT</th><th>TỪ CHỐI</th></tr></thead><tbody>@{int classIndex = 0;}@foreach (var c in Classes) { classIndex++; <tr><td>@classIndex</td><td><b>@c</b></td><td>@allRecords.Count(x => x.Lop == c)</td><td>@allRecords.Count(x => x.Lop == c && (x.TrangThai == LeaveStatuses.WaitingTrungDoi || x.TrangThai == LeaveStatuses.WaitingPhong))</td><td>@allRecords.Count(x => x.Lop == c && x.TrangThai == "Đã duyệt")</td><td>@allRecords.Count(x => x.Lop == c && x.TrangThai == "Từ chối")</td></tr> }</tbody></table></div></section>
                }
                else if (activeTab == "audit" && Session.CanExport)
                {
                    <section class="panel"><div class="panel-head"><div><h2>NHẬT KÝ XỬ LÝ</h2><p>Lưu dấu vết các thao tác thêm, sửa, xóa và xét duyệt.</p></div><button class="btn outline" @onclick="Reload">↻ Làm mới</button></div><div class="table-scroll"><table><thead><tr><th>THỜI GIAN</th><th>TÀI KHOẢN</th><th>THAO TÁC</th><th>ĐỐI TƯỢNG</th></tr></thead><tbody>@foreach (var log in audit) { <tr><td>@log.At.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@log.User</td><td><b>@log.Action</b></td><td>@log.Detail</td></tr> }</tbody></table></div></section>
                }
            </main>
            <footer class="footer">© 2026 · Hệ thống quản lý học viên nghỉ phép · Bản minh họa phục vụ bài tập lớn <span>Blazor Web App · .NET 8</span></footer>
        </div>
    </div>
    </div>

    @if (detail is not null)
    {
        <div class="overlay" @onclick="CloseDetail">
            <div class="modal document-modal" role="dialog" aria-modal="true" aria-label="Chi tiết đơn nghỉ phép" @onclick:stopPropagation="true">
                <div class="modal-head"><div><p class="eyebrow">HỒ SƠ XIN NGHỈ PHÉP</p><h2>@(detail.Id == 0 ? "Xem trước đơn nghỉ" : "Chi tiết đơn nghỉ phép")</h2></div><button class="x-button" title="Đóng" @onclick="CloseDetail">×</button></div>
                <div class="modal-scroll">
                    <div class="detail-info"><span><b>Học viên:</b> @detail.HoTen · @detail.MaHocVien</span><span><b>Trạng thái:</b> <span class="@StatusClass(detail.TrangThai)">@detail.TrangThai</span></span></div>
                    <div id="leave-print-paper" class="official-paper">
                        <div class="paper-heading">
                            <b>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</b>
                            <b class="national-motto">Độc lập – Tự do – Hạnh phúc</b>
                        </div>
                        <p class="paper-dateline">Hà Nội, ngày @((detail.NgayTao == default ? DateTime.Today : detail.NgayTao).ToString("dd")) tháng @((detail.NgayTao == default ? DateTime.Today : detail.NgayTao).ToString("MM")) năm @((detail.NgayTao == default ? DateTime.Today : detail.NgayTao).ToString("yyyy"))</p>
                        <h2>ĐƠN XIN NGHỈ PHÉP</h2>
                        <div class="paper-greeting"><b>Kính gửi:</b><div>- Lãnh đạo Phòng Quản lý học viên<div>- Chủ nhiệm Trung đội: @detail.TrungDoi</div></div></div>
                        <p class="paper-indent">Tên em là: <span class="paper-underlined">@detail.HoTen</span> Học viên lớp: <span class="paper-underlined">@detail.Lop</span></p>
                        <p class="paper-indent">Em làm đơn này xin phép được nghỉ học, nghỉ sinh hoạt để giải quyết việc riêng, thời gian:</p>
                        <p class="paper-time">- Từ: <b>@detail.TuThoiDiem.ToString("HH")</b> giờ <b>@detail.TuThoiDiem.ToString("mm")</b> phút, ngày <b>@detail.TuThoiDiem.ToString("dd")</b> tháng <b>@detail.TuThoiDiem.ToString("MM")</b> năm <b>@detail.TuThoiDiem.ToString("yyyy")</b></p>
                        <p class="paper-time">- Đến: <b>@detail.DenThoiDiem.ToString("HH")</b> giờ <b>@detail.DenThoiDiem.ToString("mm")</b> phút, ngày <b>@detail.DenThoiDiem.ToString("dd")</b> tháng <b>@detail.DenThoiDiem.ToString("MM")</b> năm <b>@detail.DenThoiDiem.ToString("yyyy")</b></p>
                        <p class="paper-indent">Lý do xin nghỉ: <span class="paper-underlined">@detail.LyDo</span></p>
                        <p class="paper-indent">Địa chỉ nơi nghỉ: <span class="paper-underlined">@detail.DiaChiNoiNghi</span></p>
                        <p class="paper-indent">Em xin cam kết thực hiện đúng các quy định về việc nghỉ phép và quy định của địa phương nơi đến nghỉ.</p>
                        <p class="paper-indent">Kính mong Lãnh đạo Phòng quản lý học viên, thầy (cô) giáo chủ nhiệm quan tâm giải quyết.</p>
                        <p class="paper-indent">Em xin chân thành cảm ơn./.</p>
                        <div class="paper-applicant"><b>NGƯỜI XIN PHÉP</b><div class="paper-sign-space"></div><strong>@detail.HoTen</strong></div>
                        <div class="paper-approvers"><b>TRƯỞNG PHÒNG QLHV</b><b>CHỦ NHIỆM TRUNG ĐỘI</b></div>
                        <div class="paper-footnote"><b><i>Ghi chú:</i></b> <i>- Sau khi được cấp phép, học viên nộp giấy phép về Chủ nhiệm trung đội</i><div><i>- Học viên sử dụng thẻ kiểm soát an ninh để ra vào cổng</i></div></div>
                    </div>
                    @if (detail.Id != 0)
                    {
                        <div class="decision-line">
                            <div><b>Cấp trung đội:</b> @(detail.NgayDuyetTrungDoi.HasValue ? (detail.TrangThai == LeaveStatuses.Rejected && !detail.NgayDuyetPhong.HasValue ? "Từ chối" : "Đã duyệt") : "Chưa duyệt") @if (detail.NgayDuyetTrungDoi.HasValue) { <span> · @detail.NguoiDuyetTrungDoi · @detail.NgayDuyetTrungDoi.Value.ToString("dd/MM/yyyy HH:mm")</span> }</div>
                            <div><b>Phòng QLHV:</b> @(detail.NgayDuyetPhong.HasValue ? (detail.TrangThai == LeaveStatuses.Approved ? "Đã duyệt" : "Từ chối") : "Chưa duyệt") @if (detail.NgayDuyetPhong.HasValue) { <span> · @detail.NguoiDuyetPhong · @detail.NgayDuyetPhong.Value.ToString("dd/MM/yyyy HH:mm")</span> }</div>
                            @if (!string.IsNullOrWhiteSpace(detail.GhiChuDuyet)) { <div><b>Ý kiến:</b> @detail.GhiChuDuyet</div> }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(modalError))
                    {
                        <div class="alert error">@modalError</div>
                    }
                    @if (detail.Id != 0 && CanReviewDetail(detail))
                    {
                        <div class="review-form"><label class="field-label">Ý kiến xét duyệt (bắt buộc khi từ chối)</label><textarea rows="2" maxlength="300" @bind="reviewNote" placeholder="Nhập ý kiến xét duyệt..."></textarea></div>
                    }
                </div>
                <div class="modal-actions"><button class="btn outline" @onclick="CloseDetail">Đóng</button><button class="btn outline" @onclick="PrintDetail">▧ In đơn</button>@if (Session.CanManage && detail.Id != 0 && CanReviewDetail(detail)) { <button class="btn outline" @onclick="() => BeginEdit(detail)">✎ Sửa đơn</button> }@if (detail.Id != 0 && CanReviewDetail(detail)) { <button class="btn danger" @onclick="() => ReviewLeave(false)">× Từ chối</button><button class="btn primary" @onclick="() => ReviewLeave(true)">✓ Duyệt đơn</button> }</div>
            </div>
        </div>
    }
    @if (editOpen && Session.CanManage)
    {
        <div class="overlay" @onclick="CancelEdit"><div class="modal edit-modal" role="dialog" aria-modal="true" aria-label="Sửa đơn nghỉ phép" @onclick:stopPropagation="true"><div class="modal-head"><div><p class="eyebrow">CHỈNH SỬA THÔNG TIN</p><h2>Sửa đơn nghỉ phép</h2></div><button class="x-button" @onclick="CancelEdit">×</button></div>
            <div class="edit-fields form-grid">
                <div class="field span-2"><label>Học viên</label><select @bind="editInput.MaHocVien">@foreach (var s in students) { <option value="@s.MaHocVien">@s.MaHocVien - @s.HoTen</option> }<option value="__manual__">＋ Tự nhập học viên</option></select></div>
                @if (editInput.MaHocVien == "__manual__")
                {
                    <div class="field"><label>Mã học viên tự nhập</label><input @bind="editInput.MaHocVienTuNhap" maxlength="30" /></div>
                    <div class="field"><label>Họ tên học viên</label><input @bind="editInput.TenHocVienTuNhap" maxlength="100" /></div>
                    <div class="field span-2"><label>Lớp học viên</label><input @bind="editInput.LopTuNhap" maxlength="60" /></div>
                }
                <div class="field"><label>Chủ nhiệm trung đội</label><input @bind="editInput.TrungDoi" maxlength="80" /></div>
                <div class="field"><label>Loại đơn</label><input value="@(editInput.TuThoiDiem.Date == editInput.DenThoiDiem.Date ? "Trong ngày" : "Dài ngày")" disabled /></div>
                <div class="field"><label>Bắt đầu nghỉ</label><div class="date-time-pair"><input aria-label="Ngày bắt đầu sửa" type="date" @bind="EditStartDate" @bind:format="yyyy-MM-dd" /><input aria-label="Giờ bắt đầu sửa" type="time" value="@EditStartTime" @onchange="e => EditStartTime = e.Value?.ToString() ?? string.Empty" /></div></div>
                <div class="field"><label>Kết thúc nghỉ</label><div class="date-time-pair"><input aria-label="Ngày kết thúc sửa" type="date" @bind="EditEndDate" @bind:format="yyyy-MM-dd" /><input aria-label="Giờ kết thúc sửa" type="time" value="@EditEndTime" @onchange="e => EditEndTime = e.Value?.ToString() ?? string.Empty" /></div></div>
                <div class="field span-2"><label>Lý do</label><textarea rows="2" maxlength="500" @bind="editInput.LyDo"></textarea></div>
                <div class="field span-2"><label>Địa chỉ nơi nghỉ</label><textarea rows="2" maxlength="300" @bind="editInput.DiaChiNoiNghi"></textarea></div>
            </div>@if (!string.IsNullOrWhiteSpace(modalError)) { <div class="alert error modal-inline-error">@modalError</div> }<div class="modal-actions"><button class="btn outline" @onclick="CancelEdit">Hủy</button><button class="btn primary" @onclick="SaveEdit">✓ Lưu thay đổi</button></div></div>
        </div>
    }
    
